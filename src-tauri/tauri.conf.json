{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapStudio",
  "version": "0.1.0",
  "identifier": "com.yanzilong.snapstudio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SnapStudio",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true,
        "focus": true,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "fullscreen": false,
        "backgroundColor": "#070910"
      }
    ],
    "security": {
      "csp": "default-src 'self' data:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 晏子龙",
    "category": "Utility",
    "shortDescription": "截图标注工作台",
    "longDescription": "全局热键唤起、免授权截屏、十种标注工具的跨平台桌面截图工具",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
